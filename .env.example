# RocketRide (synced from extension when connected; copy to .env and fill secrets)
ROCKETRIDE_URI=http://localhost:5565
ROCKETRIDE_APIKEY=

# Dev engine auth (default when running local engine)
ROCKETRIDE_APIKEY=MYAPIKEY

# GMI Cloud inference
GMI_API_KEY=
GMI_ORG_ID=
GMI_CHAT_URL=https://api.gmi-serving.com/v1/chat/completions
GMI_MODEL=deepseek-v3

# RocketRide GMI Cloud compatibility
ROCKETRIDE_GMI_CLOUD_APIKEY=
ROCKETRIDE_GMI_ORG_ID=

# Optional: point pipelines at bulk data on disk
ROCKETRIDE_VC_DATA_PATH=/Users/matysanchez/playground/vcs-data

# Optional: connect the Vite frontend to Sarah's local API adapter
VITE_VCME_API_URL=http://127.0.0.1:8787
